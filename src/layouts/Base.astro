---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  descricao?: string;
}

const { titulo, descricao = 'Tecnologia e saúde a favor da qualidade de vida.' } = Astro.props;
const tituloCompleto = titulo === 'Conecta Saúde' ? titulo : `${titulo} | Conecta Saúde`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#1c6a4f" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{tituloCompleto}</title>
  </head>
  <body>
    <a class="pular" href="#conteudo">Ir para o conteúdo</a>
    <div class="pagina">
      <Header />
      <main id="conteudo" class="container principal" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
